# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# velite (generated content data)
/.velite
/public/rag-index.json

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: keep only the empty template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# editors
.vscode/
.idea/

# local scratch and build output
/tmp/
/output/

# private CV sources and PDFs (include CGPA, phone and photo).
# The website's CGPA-free copy lives in public/resume/ and is committed.
/cv/
