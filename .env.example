# ---------------------------------------------------------------------------
# Imtiaz Hossain Portfolio — environment variables
# Everything here is OPTIONAL. The site builds and runs fully without any key;
# these unlock enhanced features and gracefully degrade when unset.
# Copy to .env.local and fill what you need.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, sitemap, OpenGraph). Set on deploy.
NEXT_PUBLIC_SITE_URL="https://imtiazhossain.dev"

# --- AI assistant -----------------------------------------------------------
# Selects the LLM backend for the RAG assistant. One of: gemini | openrouter | groq
AI_PROVIDER="gemini"
# Optional model override (defaults: gemini-2.5-flash / llama-3.3-70b).
# AI_MODEL="gemini-2.5-flash"

# Provide the key for whichever provider you chose above.
# Gemini also powers vector embeddings for the RAG index (optional; lexical
# search works without it).
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# --- GitHub activity panel --------------------------------------------------
# Optional. With a token, the homepage shows pinned repos + a real contribution
# calendar via GraphQL. Without it, a public REST fallback fetches top repos.
# A classic PAT with `read:user` and `public_repo` scope is sufficient.
GITHUB_TOKEN=""

# --- Analytics & monitoring (optional) --------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_SENTRY_DSN=""
